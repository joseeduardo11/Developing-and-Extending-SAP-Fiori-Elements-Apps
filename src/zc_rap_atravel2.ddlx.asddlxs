@Metadata.layer: #CORE

@UI: {
    headerInfo: {
        typeName: 'Travel',
        typeNamePlural: 'Travels',
        title: {
            type: #STANDARD,
            value: 'TravelID' }
        },
    presentationVariant: [{
        sortOrder: [{
            by: 'TravelID',
            direction: #DESC
        }],
        visualizations: [{
            type: #AS_LINEITEM
        }]
    }]
}

annotate entity ZC_RAP_ATRAVEL2 with
{
  @UI.facet: [
  {
      id: 'TravelHeaderPrice',
      purpose: #HEADER,
      type: #DATAPOINT_REFERENCE,
      position: 10,
      targetQualifier: 'PriceData'
  },
  {
      id: 'TravelHeaderOverallStatus',
      purpose: #HEADER,
      type: #DATAPOINT_REFERENCE,
      position: 20,
      targetQualifier: 'StatusData'
  },
  {
      label: 'General Information',
      id: 'GeneralInfo',
      type: #COLLECTION,
      position: 10
  },
  {
      label: 'General',
      id: 'Travel',
      type: #IDENTIFICATION_REFERENCE,
      purpose: #STANDARD,
      parentId: 'GeneralInfo',
      position: 10
  },
  {
      label: 'Prices',
      id: 'Prices',
      type: #FIELDGROUP_REFERENCE,
      targetQualifier: 'PricesGroup',
      purpose :#STANDARD,
      parentId: 'GeneralInfo',
      position: 20
  },
  {
      label: 'Dates',
      id: 'Dates',
      type: #FIELDGROUP_REFERENCE,
      targetQualifier: 'DatesGroup',
      purpose: #STANDARD,
      parentId: 'GeneralInfo',
      position: 30
  },
  // sections "Bookings"
  {
      id: 'Booking',
      label: 'Bokings',
      purpose: #STANDARD,
      type: #LINEITEM_REFERENCE,
      position: 20,
      targetElement: '_Booking'
  }
  ]

  @UI.hidden: true
  TravelUUID;

  @EndUserText.label: 'Travel'
  @UI.lineItem: [ {
    position: 10
  } ]
  @UI.selectionField: [ {
    position: 10
  } ]
  TravelID;

  @EndUserText.label: 'Description'
  @UI.identification: [{ position: 10 }]
  Description;

  @EndUserText.label: 'Agency'
  @UI.identification: [ {
    position: 20
  } ]
  @UI.lineItem: [ {
    position: 20
  } ]
  @UI.selectionField: [ {
    position: 20
  } ]

  AgencyID;

  @EndUserText.label: 'Customer'
  @UI.identification: [ {
    position: 30
  } ]
  @UI.lineItem: [ {
    position: 30
  } ]
  @UI.selectionField: [ {
    position: 30
  } ]
  CustomerID;

  @EndUserText.label: 'Starting Date'
  @UI.lineItem: [ {
    position: 40
  } ]
  @UI.fieldGroup: [{ qualifier: 'DatesGroup', position: 10 }]
  BeginDate;

  @EndUserText.label: 'End Date'
  @UI.lineItem: [ {
    position: 50
  } ]
  @UI.fieldGroup: [{ qualifier: 'DatesGroup', position: 20 }]
  EndDate;

  @EndUserText.label: 'Booking Fee'
  @UI.lineItem: [ {
    position: 60
  } ]
  @UI.fieldGroup: [{ qualifier: 'PricesGroup', position: 10 }]
  BookingFee;

  @EndUserText.label: 'Total Price'
  @UI: {
    lineItem: [ { position: 70 } ],
    dataPoint: { qualifier: 'PriceData', title: 'Total Price' },
    fieldGroup: [{ qualifier: 'PricesGroup', position: 10 }]
  }
  TotalPrice;

  @EndUserText.label: 'Booking Status'
  @UI.lineItem: [ {
    position: 90,
    criticality: 'OverallStatusCriticality'
  } ]
  @UI.selectionField: [ {
    position: 90
  } ]
  @UI.textArrangement: #TEXT_ONLY
  @UI.dataPoint:{ qualifier: 'StatusData', title: 'Status', criticality: 'OverallStatusCriticality' }
  OverallStatus;

  @UI.hidden: true
  LocalLastChangedAt;

}