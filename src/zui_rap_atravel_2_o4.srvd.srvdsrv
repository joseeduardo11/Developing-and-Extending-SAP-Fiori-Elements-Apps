@EndUserText.label: 'Service Definition for Travel'
@ObjectModel: {
  leadingEntity: {
    name: 'ZC_RAP_ATRAVEL2'
  }
}
define service ZUI_RAP_ATRAVEL_2_O4
  provider contracts odata_v4_ui {
  expose ZC_RAP_ATRAVEL2  as Travel;
  expose ZC_RAP_ABOOK2    as Booking;
  expose ZR_RAP_ACONN2    as Connection;
  expose ZR_RAP_AFLIGHT2  as Flight;
  expose ZR_RAP_ACARRIER2 as Airline;
  expose I_Currency       as Currency;
  expose /DMO/I_Customer  as Customer;
}