projection;
strict ( 2 );
use draft;
extensible;

define behavior for ZC_RAP_ATRAVEL2 alias Travel
extensible
use etag
{
  use create;
  use update;
  use delete;

  use action Activate;
  use action Discard;
  use action Edit;
  use action Resume;
  use action Prepare;

  use association _Booking { create; with draft; }
}

define behavior for ZC_RAP_ABOOK2 alias Booking
{
  use update;
  use delete;

  use association _Travel { with draft; }
}